---
const year = new Date().getFullYear();
---

<footer
  class="mt-auto shadow-[0_-1px_0_rgba(0,0,0,0.05)] dark:shadow-[0_-1px_0_rgba(255,255,255,0.06)] py-10 text-center text-xs text-neutral-500"
>
  <div class="mx-auto max-w-6xl px-4 flex flex-col gap-2 sm:flex-row sm:justify-between">
    <span>&copy; {year}</span>
    <a
      href="/license"
      class="group inline-flex items-center gap-1 underline underline-offset-2 hover:text-black dark:hover:text-white transition-colors duration-150"
    >
      Free for personal &amp; commercial use
      <svg class="h-3 w-3 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="m9 18 6-6-6-6" />
      </svg>
    </a>
  </div>
</footer>
